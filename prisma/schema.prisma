generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  AGENT
  JEFE_AREA
  JEFE_DEPARTAMENTO
  GERENTE_GENERAL
  ANALISTA_TALENTO_HUMANO
  JEFE_TALENTO_HUMANO
}

enum PqrStatus {
  PENDIENTE
  EN_PROCESO
  CERRADA
}

enum PqrCaseType {
  SAP
  BEAS
  TERMINAL
  CORREO
  INTRANET
  SOPORTE_EQUIPOS
  SOPORTE_RED
  MI_PORTAL_SAP
  LEGALISAPP
  NUEVAS_SOLICITUDES
}

enum PqrPriority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum NotificationType {
  NEW_PQR
  STATUS_CHANGE
  PRIORITY_CHANGE
  PQR_CLOSED
  PQR_RATED
  PQR_TAKEN
  PQR_ASSIGNED
  PQR_UNASSIGNED
  REQUISITION_PENDING_APPROVAL
  REQUISITION_APPROVED
  REQUISITION_REJECTED
  HIRING_CONFIRMATION_PENDING
  HIRING_CONFIRMATION_APPROVED
  HIRING_CONFIRMATION_REJECTED
}

enum PqrAttachmentType {
  IMAGE
  DOCUMENT
}

enum RequisitionReason {
  CARGO_NUEVO
  REEMPLAZO_RETIRO
  INCREMENTO_PRODUCCION
  SOLICITUD_PRACTICANTES
  OTROS
}

enum ContractType {
  DIRECTO
  TEMPORAL
  PRACTICANTE
}

enum DirectContractType {
  INDEFINIDO
  FIJO
}

enum InternContractType {
  APRENDIZ
  PASANTE
  ROTANTE
}

enum ApprovalDecision {
  APROBADA
  RECHAZADA
  CANCELADA
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     Role   @default(USER)

  pqrsCreated  PQR[] @relation("UserPqrs")
  pqrsAssigned PQR[] @relation("AgentPqrs")

  pqrMessages   PqrMessage[]
  notifications Notification[]
  pqrChatReads  PqrChatRead[]

  personnelRequisitions PersonnelRequisition[]

  personnelRequisitionApprovals PersonnelRequisitionApproval[]

  hiringConfirmations PersonnelHiringConfirmation[]

  hiringConfirmationApprovals PersonnelHiringConfirmationApproval[]
}

model PQR {
  id          Int         @id @default(autoincrement())
  caseType    PqrCaseType
  description String      @db.VarChar(500)
  status      PqrStatus   @default(PENDIENTE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  userId Int
  user   User @relation("UserPqrs", fields: [userId], references: [id])

  assignedToId Int?
  assignedTo   User? @relation("AgentPqrs", fields: [assignedToId], references: [id])

  priority PqrPriority?

  rating        Int?
  ratingComment String?   @db.VarChar(300)
  ratedAt       DateTime?

  messages      PqrMessage[]
  notifications Notification[]
  chatReads     PqrChatRead[]
}

model PqrMessage {
  id        Int      @id @default(autoincrement())
  content   String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  pqrId Int
  pqr   PQR @relation(fields: [pqrId], references: [id], onDelete: Cascade)

  senderId Int
  sender   User @relation(fields: [senderId], references: [id])

  attachments PqrMessageAttachment[]
}

model PqrChatRead {
  id         Int      @id @default(autoincrement())
  pqrId      Int
  userId     Int
  lastReadAt DateTime @default(now())

  pqr  PQR  @relation(fields: [pqrId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pqrId, userId])
}

model PqrMessageAttachment {
  id           Int               @id @default(autoincrement())
  fileName     String
  originalName String
  fileUrl      String
  fileType     PqrAttachmentType
  mimeType     String
  fileSize     Int
  createdAt    DateTime          @default(now())

  messageId Int
  message   PqrMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model Notification {
  id                     Int              @id @default(autoincrement())
  title                  String
  message                String
  type                   NotificationType
  isRead                 Boolean          @default(false)
  userId                 Int
  pqrId                  Int?
  personnelRequisitionId Int?
  createdAt              DateTime         @default(now())

  user                 User                  @relation(fields: [userId], references: [id])
  pqr                  PQR?                  @relation(fields: [pqrId], references: [id])
  personnelRequisition PersonnelRequisition? @relation(fields: [personnelRequisitionId], references: [id])
}

model Department {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  name     String
  isActive Boolean @default(true)

  requisitions PersonnelRequisition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PositionProfile {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  name     String
  isActive Boolean @default(true)

  requisitions PersonnelRequisition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model City {
  id       Int     @id @default(autoincrement())
  name     String
  isActive Boolean @default(true)

  requisitions PersonnelRequisition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PersonnelRequisition {
  id Int @id @default(autoincrement())

  requestDate DateTime @default(now())

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  positionId Int
  position   PositionProfile @relation(fields: [positionId], references: [id])

  reason      RequisitionReason
  otherReason String?           @db.VarChar(300)

  cityId Int
  city   City @relation(fields: [cityId], references: [id])

  contractType ContractType?

  directContractType     DirectContractType?
  contractDurationMonths Int?

  internContractType InternContractType?

  proposedSalary Decimal @db.Decimal(12, 2)

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  approvals          PersonnelRequisitionApproval[]
  hiringConfirmation PersonnelHiringConfirmation?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
}

model RequisitionApprovalStep {
  id Int @id @default(autoincrement())

  name String @db.VarChar(100)

  stepOrder Int

  requiredRole Role

  isActive Boolean @default(true)

  approvals PersonnelRequisitionApproval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stepOrder])
}

model PersonnelRequisitionApproval {
  id Int @id @default(autoincrement())

  requisitionId Int
  requisition   PersonnelRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  stepId Int
  step   RequisitionApprovalStep @relation(fields: [stepId], references: [id])

  decision ApprovalDecision

  decidedById Int
  decidedBy   User @relation(fields: [decidedById], references: [id])

  decidedAt DateTime @default(now())

  comment String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requisitionId, stepId])
}

model PersonnelHiringConfirmation {
  id Int @id @default(autoincrement())

  requisitionId Int                  @unique
  requisition   PersonnelRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  contractType ContractType

  directContractType     DirectContractType?
  contractDurationMonths Int?

  internContractType InternContractType?

  approvedSalary Decimal @db.Decimal(12, 2)

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  approvals PersonnelHiringConfirmationApproval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HiringConfirmationApprovalStep {
  id Int @id @default(autoincrement())

  name String @db.VarChar(100)

  stepOrder Int

  requiredRole Role

  isActive Boolean @default(true)

  approvals PersonnelHiringConfirmationApproval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stepOrder])
}

model PersonnelHiringConfirmationApproval {
  id Int @id @default(autoincrement())

  hiringConfirmationId Int
  hiringConfirmation   PersonnelHiringConfirmation @relation(fields: [hiringConfirmationId], references: [id], onDelete: Cascade)

  stepId Int
  step   HiringConfirmationApprovalStep @relation(fields: [stepId], references: [id])

  decision ApprovalDecision

  decidedById Int
  decidedBy   User @relation(fields: [decidedById], references: [id])

  decidedAt DateTime @default(now())

  comment String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hiringConfirmationId, stepId])
}
